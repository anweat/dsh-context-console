{
  "name": "dsh-context-console",
  "version": "0.1.1-alpha.3",
  "description": "DSH context console with trajectory, prompt/skill/MCP/tool inventory, message forging, and conservative session-log recovery.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "docs",
    "src",
    "CHANGELOG.md",
    "MIGRATION.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean-lib.mjs && tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:manager && npm run test:client-bundle && npm run test:session-repair",
    "test:manager": "node --test --experimental-transform-types test/*.test.ts",
    "test:client-bundle": "node scripts/check-client-bundle.mjs",
    "test:session-repair": "node scripts/test-session-repair.mjs",
    "test:package": "publint",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:package",
    "prepack": "npm run verify",
    "prepare": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/anweat/dsh-context-console.git" },
  "bugs": { "url": "https://github.com/anweat/dsh-context-console/issues" },
  "homepage": "https://github.com/anweat/dsh-context-console#readme",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "context-console",
    "session-log",
    "prompt",
    "mcp",
    "tools",
    "client-plugin"
  ],
  "publishConfig": { "access": "public", "provenance": true },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-renderer": { "optional": true },
    "@deepseek-ai/dsh-client-ui-session": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-connection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "lightningcss": "^1.32.0",
    "publint": "^0.3.21",
    "react": "^18.2.0",
    "react-dom": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@11.7.0"
}
